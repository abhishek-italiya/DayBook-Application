{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/logo.svg",
      "dest": "frontend/logo.svg"
    },
    {
      "src": "/daybook-image.jpg",
      "dest": "frontend/daybook-image.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ]
}
